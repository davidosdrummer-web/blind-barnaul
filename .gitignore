```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/
out/
public/build/

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temporary files
*.tmp
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/
.tox/

# Node.js specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled JavaScript
*.min.js
*.bundle.js

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
```